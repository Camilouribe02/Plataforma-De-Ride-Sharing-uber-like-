<?php
session_start();
require_once "conexion.php";

if (!isset($_SESSION['usuario_id'])) { header('Location: index.php'); exit; }
$id = (int)$_SESSION['usuario_id'];
$stmt = $conexion->prepare("SELECT id,nombre,apellido,correo,rol,foto FROM usuarios WHERE id=? LIMIT 1");
$stmt->bind_param('i',$id); $stmt->execute();
$usuario = $stmt->get_result()->fetch_assoc();
if (!$usuario) { session_destroy(); header('Location: index.php'); exit; }
if (($usuario['rol'] ?? '') === 'conductor') { $esConductor=true; } else { $esConductor=false; }
$nombre = htmlspecialchars($usuario['nombre'] ?? 'Usuario', ENT_QUOTES, 'UTF-8');
$foto = htmlspecialchars($usuario['foto'] ?? '', ENT_QUOTES, 'UTF-8');
?>
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RideShare | Solicitar viaje</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
